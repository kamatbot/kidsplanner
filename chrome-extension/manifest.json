{
  "manifest_version": 3,
  "name": "Fam ETC School Helper",
  "version": "0.5.1",
  "description": "Syncs school stats not available in the private feeds and delivers verified legacy homework completions using your logged-in Moodle session.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fam ETC School Helper"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://bangkok.learn.nae.school/*"],
      "js": ["parse.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["scripting", "storage"],
  "host_permissions": [
    "https://bangkok.learn.nae.school/*",
    "https://www.fametc.com/*",
    "https://fametc.com/*"
  ]
}

{
  "manifest_version": 3,
  "name": "Fam ETC School Import",
  "version": "0.4.0",
  "description": "Syncs Moodle school data into Fam ETC and verified homework completions back to Moodle using your logged-in session.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fam ETC School Import"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://bangkok.learn.nae.school/*"],
      "js": ["parse.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["scripting", "storage"],
  "host_permissions": [
    "https://bangkok.learn.nae.school/*",
    "https://www.fametc.com/*",
    "https://fametc.com/*"
  ]
}
